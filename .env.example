# URL of the FastAPI backend (no trailing slash). Example: https://api.example.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# "true"  -> run fully on built-in demo data (no backend needed)
# "false" -> call the real FastAPI backend at VITE_API_BASE_URL
VITE_USE_MOCK=true

# "hash"    -> URLs look like /#/app/dashboard. Works on ANY host with zero server config (default).
# "browser" -> clean URLs. Needs SPA fallback (vercel.json / public/_redirects / nginx try_files are included).
VITE_ROUTER=hash
